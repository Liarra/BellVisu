{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Liarra/BellVisu/blob/main/config/visualisation.schema.json",
  "title": "The Bell visualisation configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["backgroundColor", "masterVolume", "events"],
  "properties": {
    "$schema": { "type": "string" },
    "backgroundColor": { "$ref": "#/$defs/colour" },
    "masterVolume": { "type": "number", "minimum": 0, "maximum": 1.5 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "colour": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "partial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitchHz", "amplitude", "decaySeconds"],
      "properties": {
        "pitchHz": { "type": "number", "minimum": 20, "maximum": 18000 },
        "amplitude": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "decaySeconds": { "type": "number", "minimum": 0.05, "maximum": 30 }
      }
    },
    "variation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitchCents", "amplitude", "decay", "resonatorBanks"],
      "properties": {
        "pitchCents": { "type": "number", "minimum": 0, "maximum": 100 },
        "amplitude": { "type": "number", "minimum": 0, "maximum": 0.75 },
        "decay": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "resonatorBanks": { "type": "integer", "minimum": 1, "maximum": 12 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "frequencyPerMinute", "jitter", "ripple", "sound"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "frequencyPerMinute": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 1000000
        },
        "jitter": { "type": "number", "minimum": 0, "maximum": 0.95 },
        "ripple": {
          "type": "object",
          "additionalProperties": false,
          "required": ["color", "shape", "maxSize", "fadeSeconds"],
          "properties": {
            "color": { "$ref": "#/$defs/colour" },
            "shape": { "enum": ["normal", "partial", "wavy"] },
            "maxSize": { "type": "number", "minimum": 8, "maximum": 500 },
            "fadeSeconds": { "type": "number", "minimum": 0.1, "maximum": 30 }
          }
        },
        "sound": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bellName",
            "volume",
            "reverbSeconds",
            "reverbWet",
            "pan",
            "variation",
            "partials"
          ],
          "properties": {
            "bellName": { "type": "string", "minLength": 1 },
            "volume": { "type": "number", "minimum": 0, "maximum": 5 },
            "reverbSeconds": { "type": "number", "minimum": 0.05, "maximum": 20 },
            "reverbWet": { "type": "number", "minimum": 0, "maximum": 1 },
            "pan": { "type": "number", "minimum": -1, "maximum": 1 },
            "variation": { "$ref": "#/$defs/variation" },
            "partials": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/partial" }
            }
          }
        }
      }
    }
  }
}
