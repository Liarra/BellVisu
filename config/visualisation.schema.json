{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Liarra/BellVisu/blob/main/config/visualisation.schema.json",
  "title": "The Bell visualisation configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["backgroundColor", "masterVolume", "globalVariation", "events"],
  "properties": {
    "$schema": { "type": "string" },
    "backgroundColor": { "$ref": "#/$defs/colour" },
    "masterVolume": { "type": "number", "minimum": 0, "maximum": 1.5 },
    "globalVariation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startTimeJitterMs"],
      "properties": {
        "startTimeJitterMs": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "colour": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "partial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ratio", "gain", "decaySec", "detuneCents"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ratio": { "type": "number", "minimum": 0.05, "maximum": 16 },
        "gain": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 },
        "decaySec": { "type": "number", "minimum": 0.05, "maximum": 30 },
        "detuneCents": { "type": "number", "minimum": -100, "maximum": 100 }
      }
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voiceLabel",
        "primeHz",
        "notePoolHz",
        "partials",
        "attackMs",
        "strikeNoise",
        "strikeNoiseDecayMs",
        "lowpassHz",
        "highpassHz",
        "reverbSend",
        "reverbTimeSec",
        "predelayMs",
        "stereoWidth",
        "pan",
        "pitchJitterCents",
        "gainJitter",
        "decayJitter",
        "masterGain",
        "maxVoices"
      ],
      "properties": {
        "voiceLabel": { "type": "string", "minLength": 1 },
        "primeHz": { "type": "number", "minimum": 20, "maximum": 18000 },
        "notePoolHz": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 20, "maximum": 18000 }
        },
        "partials": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/partial" }
        },
        "attackMs": { "type": "number", "minimum": 0, "maximum": 500 },
        "strikeNoise": { "type": "number", "minimum": 0, "maximum": 1 },
        "strikeNoiseDecayMs": { "type": "number", "minimum": 1, "maximum": 1000 },
        "lowpassHz": { "type": "number", "minimum": 100, "maximum": 20000 },
        "highpassHz": { "type": "number", "minimum": 0, "maximum": 5000 },
        "reverbSend": { "type": "number", "minimum": 0, "maximum": 1 },
        "reverbTimeSec": { "type": "number", "minimum": 0.05, "maximum": 20 },
        "predelayMs": { "type": "number", "minimum": 0, "maximum": 250 },
        "stereoWidth": { "type": "number", "minimum": 0, "maximum": 1 },
        "pan": { "type": "number", "minimum": -1, "maximum": 1 },
        "pitchJitterCents": { "type": "number", "minimum": 0, "maximum": 100 },
        "gainJitter": { "type": "number", "minimum": 0, "maximum": 0.75 },
        "decayJitter": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "masterGain": { "type": "number", "minimum": 0, "maximum": 5 },
        "maxVoices": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "frequencyPerMinute", "jitter", "ripple", "sound"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "frequencyPerMinute": { "type": "number", "minimum": 0.001, "maximum": 1000000 },
        "jitter": { "type": "number", "minimum": 0, "maximum": 0.95 },
        "ripple": {
          "type": "object",
          "additionalProperties": false,
          "required": ["color", "shape", "maxSize", "fadeSeconds"],
          "properties": {
            "color": { "$ref": "#/$defs/colour" },
            "shape": { "enum": ["normal", "partial", "wavy"] },
            "maxSize": { "type": "number", "minimum": 8, "maximum": 500 },
            "fadeSeconds": { "type": "number", "minimum": 0.1, "maximum": 30 }
          }
        },
        "sound": { "$ref": "#/$defs/sound" }
      }
    }
  }
}
